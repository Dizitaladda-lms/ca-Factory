# Configure these on the backend server only. Never add portal credentials to VITE_* variables.
# Supabase Project Settings → Database → Connection string (URI), configured on the backend only.
DATABASE_URL=postgresql://postgres:your-password@your-project-pooler.supabase.com:6543/postgres?sslmode=require
SEO_PORTAL_LOGIN_ID=your-seo-login-id
SEO_PORTAL_LOGIN_PASSWORD=replace-with-a-long-unique-password
