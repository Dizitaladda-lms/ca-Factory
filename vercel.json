{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/app.js"
    }
  },
  "rewrites": [
    {
      "source": "/blog/:path*",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    { "source": "/sitemap.xml", "destination": { "type": "service", "service": "backend" } },
    { "source": "/robots.txt", "destination": { "type": "service", "service": "backend" } },
    { "source": "/rss.xml", "destination": { "type": "service", "service": "backend" } },
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
